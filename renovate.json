{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^openseadragon\\.libraries\\.yml$/",
        "/^openseadragon\\.module$/"
      ],
      "matchStrings": [
        "openseadragon:\\n(?:  .*\\n)*?  version: (?<currentValue>[^\\s]+)",
        "openseadragon:\\n(?:  .*\\n)*?https://cdn\\.jsdelivr\\.net/npm/openseadragon@(?<currentValue>[^/]+)/build/openseadragon/openseadragon\\.min\\.js",
        "https://cdn\\.jsdelivr\\.net/npm/openseadragon@(?<currentValue>[^/]+)/build/openseadragon/images/"
      ],
      "depNameTemplate": "openseadragon/openseadragon",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
